{
  "name": "@medusajs/ui-preset",
  "version": "2.17.2",
  "description": "Medusa UI preset",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/medusajs/medusa.git",
    "directory": "packages/design-system/ui-preset"
  },
  "bugs": {
    "url": "https://github.com/medusajs/medusa/issues"
  },
  "author": "Kasper Kristensen <kasper@medusajs.com>",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.mjs",
      "require": "./dist/runtime.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "scripts": {
    "build": "yarn run -T tsup",
    "generate": "toolbox tokens -o './src/theme'",
    "validate:themes": "bun run scripts/validate-theme-contrast.ts",
    "sync:tweakcn": "node scripts/sync-tweakcn-themes.mjs",
    "generate:tweakcn": "node scripts/generate-tweakcn-themes.mjs",
    "audit:tweakcn": "node scripts/audit-tweakcn-themes.mjs"
  },
  "dependencies": {
    "@tailwindcss/forms": "^0.5.3",
    "tailwindcss-animate": "^1.0.6"
  },
  "peerDependencies": {
    "tailwindcss": "^3.4.3"
  },
  "devDependencies": {
    "@medusajs/toolbox": "2.17.2",
    "tailwindcss": "^3.4.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
