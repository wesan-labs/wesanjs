{
  "name": "@wesanjs/mail-plugin",
  "version": "2.15.5",
  "description": "Medusa Plugin: Panel Mail (Stalwart-backed staff mailboxes)",
  "license": "MIT",
  "files": [
    ".medusa/server"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./modules/mail": "./.medusa/server/src/modules/mail/index.js",
    "./.medusa/server/src/modules/mail": "./.medusa/server/src/modules/mail/index.js",
    "./workflows": {
      "import": "./.medusa/server/src/workflows/index.js",
      "types": "./.medusa/server/src/workflows/index.d.ts",
      "require": "./.medusa/server/src/workflows/index.js"
    },
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "test": "jest",
    "prepare": "cross-env NODE_ENV=production yarn run build"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.15.5",
    "@medusajs/cli": "2.15.5",
    "@medusajs/dashboard": "2.15.5",
    "@medusajs/framework": "2.15.5",
    "@medusajs/icons": "2.15.5",
    "@medusajs/test-utils": "2.15.5",
    "@medusajs/types": "2.15.5",
    "@medusajs/ui": "4.1.15",
    "@swc/core": "1.5.7",
    "@types/node": "^20.0.0",
    "cross-env": "^7.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  },
  "peerDependencies": {
    "@medusajs/framework": "2.15.5"
  }
}
