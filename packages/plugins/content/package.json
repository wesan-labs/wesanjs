{
  "name": "@medusajs/content-plugin",
  "version": "2.15.5",
  "description": "Wesan Plugin: Content Studio — AI image/text/video-prompt generation (sector packs, transform/generate, vision analysis) + content library",
  "author": "Wesan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/medusajs/medusa",
    "directory": "packages/plugins/content"
  },
  "files": [
    ".medusa/server"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./modules/content-library": "./.medusa/server/src/modules/content-library/index.js",
